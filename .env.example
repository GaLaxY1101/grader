# Grader backend — environment template.
# Copy to .env and fill in before `docker compose -f compose.server.yaml up -d --build`.
# Never commit .env.
#
# Generate secrets with: openssl rand -base64 32
# JWT secret must be at least 32 characters long.

# ─── Public host ──────────────────────────────────────────────────────────────
# Hostname or IP browsers use to reach the server (no scheme, no port).
PUBLIC_HOST=grader.example.edu

# ─── Secrets (required) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
GRADER_JWT_SECRET=change-me-at-least-32-characters-long
GITLAB_WEBHOOK_SECRET=change-me
NEXTAUTH_SECRET=change-me
# Keycloak client secret of grader-frontend; Keycloak reads it only on first realm import.
GRADER_FRONTEND_CLIENT_SECRET=change-me

# ─── GitLab integration ───────────────────────────────────────────────────────
# Filled in after GitLab's first start (see DEPLOY.md, step 4). Empty = integration off.
GITLAB_TOKEN=
GITLAB_RUNNER_TOKEN=

# ─── AI test generation ───────────────────────────────────────────────────────
# 3b runs on CPU; use qwen2.5-coder:7b with GPU of >= 8 GB VRAM.
TESTGEN_MODEL=qwen2.5-coder:3b

# ─── Published ports (defaults shown) ─────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8080
KEYCLOAK_PORT=9080
S3_PORT=9000
GITLAB_PORT=8929
GITLAB_SSH_PORT=2224

# ─── Optional overrides (local dev / advanced) ────────────────────────────────
# Below values have working defaults in application.yml / compose.yaml.
# Uncomment only when overriding.
#
# KEYCLOAK_BASE_URL=http://localhost:9080
# KEYCLOAK_REALM=university-grader
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# KEYCLOAK_ISSUER_URI=http://localhost:9080/realms/university-grader
# KEYCLOAK_JWK_URI=http://localhost:9080/realms/university-grader/protocol/openid-connect/certs
#
# GRADER_CORS_ORIGINS=http://localhost:3000
#
# GITLAB_BASE_URL=http://localhost:8929
# GITLAB_GROUP_NAME=grader
# GITLAB_WEBHOOK_BASE_URL=http://host.docker.internal:8080
#
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_PUBLIC_ENDPOINT=
# MINIO_ACCESS_KEY=grader
# MINIO_SECRET_KEY=graderminio123
# MINIO_BUCKET=grader-attachments
# MINIO_PRESIGN_TTL=300
#
# OLLAMA_BASE_URL=http://localhost:11434
