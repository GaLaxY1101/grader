# Copy to .env and fill in before `docker compose -f compose.server.yaml up -d --build`.
# Never commit .env.

# Hostname or IP that browsers use to reach the server (no scheme, no port).
PUBLIC_HOST=grader.example.edu

# Secrets — generate e.g. with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
GRADER_JWT_SECRET=change-me-at-least-32-characters-long
GITLAB_WEBHOOK_SECRET=change-me

# Filled in after GitLab's first start (see DEPLOY.md, step 4). Empty = GitLab integration off.
GITLAB_TOKEN=
GITLAB_RUNNER_TOKEN=

# LLM for AI test generation. 3b runs on CPU; use qwen2.5-coder:7b with a GPU of >= 8 GB VRAM.
TESTGEN_MODEL=qwen2.5-coder:3b

# Published ports (defaults shown).
BACKEND_PORT=8080
KEYCLOAK_PORT=9080
S3_PORT=9000
GITLAB_PORT=8929
GITLAB_SSH_PORT=2224
